plugins {
    id 'com.android.application'
    id 'kotlin-android'
    id 'kotlinx-serialization'
}

android {
    compileSdk 35
    namespace 'eu.kanade.tachiyomi.extension.ar.procomic'

    defaultConfig {
        minSdk 21
        targetSdk 35
        versionCode 1
        versionName "1.0"

        applicationId "eu.kanade.tachiyomi.extension.ar.procomic"

        resValue "string", "app_name", "ProComic"
        resValue "string", "source_lang", "ar"
    }

    buildTypes {
        release {
            minifyEnabled false
        }
        debug {
            // For development and testing
        }
    }

    kotlinOptions {
        jvmTarget = "17"
        freeCompilerArgs += ["-opt-in=kotlinx.serialization.ExperimentalSerializationApi"]
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }

    sourceSets {
        main {
            kotlin.srcDirs = ['src/main/kotlin']
            res.srcDirs = ['src/main/res']
            manifest.srcFile 'src/main/AndroidManifest.xml'
        }
    }
}

repositories {
    google()
    mavenCentral()
    maven { url 'https://jitpack.io' }
}

dependencies {
    // Tachiyomi extension library
    compileOnly 'com.github.tachiyomiorg:extensions-lib:1.5'

    // Kotlin + Serialization
    implementation 'org.jetbrains.kotlin:kotlin-stdlib:2.0.0'
    implementation 'org.jetbrains.kotlinx:kotlinx-serialization-json:1.7.1'

    // OkHttp (provided by Tachiyomi app at runtime)
    compileOnly 'com.squareup.okhttp3:okhttp:4.12.0'

    // Jsoup (provided by Tachiyomi app at runtime, needed for interface compliance)
    compileOnly 'org.jsoup:jsoup:1.16.2'
}
