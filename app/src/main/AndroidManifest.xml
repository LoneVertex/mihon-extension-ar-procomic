<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        CRITICAL: Mihon discovers extensions by scanning for packages that declare
        <uses-feature android:name="tachiyomi.extension" />.
        WITHOUT this, Mihon silently ignores the package entirely.
        Confirmed from MangaSwat APK manifest analysis (2026-07-29).
    -->
    <uses-feature android:name="tachiyomi.extension" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Tachiyomi: ProComic"
        android:allowBackup="false">
        <meta-data
            android:name="tachiyomi.extension.class"
            android:value=".ProComic" />
        <meta-data
            android:name="tachiyomix.name"
            android:value="ProComic" />
        <meta-data
            android:name="tachiyomi.extension.nsfw"
            android:value="0" />
        <meta-data
            android:name="tachiyomix.contentWarning"
            android:value="0" />
        <meta-data
            android:name="tachiyomix.extensionLib"
            android:value="1.6" />
    </application>
</manifest>
