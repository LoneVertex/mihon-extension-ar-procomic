<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name">
        <!--
            Meta-data keys confirmed from MangaSwat (working extension, 2026-07-28).
            Mihon's ExtensionLoader scans for 'tachiyomi.extension.class' — NOT 'source.class'.
            Using wrong key names was the root cause of the extension not appearing in Mihon.
        -->
        <meta-data
            android:name="tachiyomi.extension.class"
            android:value=".ProComic" />
        <meta-data
            android:name="tachiyomix.name"
            android:value="ProComic" />
        <meta-data
            android:name="tachiyomi.extension.nsfw"
            android:value="0" />
        <meta-data
            android:name="tachiyomix.contentWarning"
            android:value="0" />
        <meta-data
            android:name="tachiyomix.extensionLib"
            android:value="1.6" />
    </application>
</manifest>
